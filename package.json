{
  "name": "clps-lunar-mission-browser",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive lunar mission browser for CLPS landers — NASA Space Apps Challenge 2026 (Amman).",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "cesium:assets": "node scripts/copy-cesium-assets.mjs",
    "predev": "npm run cesium:assets",
    "dev": "vite",
    "prebuild": "npm run cesium:assets",
    "build": "tsc -b && vite build",
    "postbuild": "node scripts/check-no-secrets.mjs dist",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run test && npm run build",
    "horizons:fetch": "node scripts/run-ts.mjs scripts/fetch_horizons.ts",
    "horizons:check": "node scripts/run-ts.mjs scripts/horizons_check.ts"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "cesium": "^1.146.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
