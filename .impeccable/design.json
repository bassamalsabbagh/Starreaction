  "narrative": {
    "northStar": "The Moon is the screen",
    "overview": "A full-screen, Sun-lit Moon with quiet instruments around its edge: a menu rail, one panel, a status line and a timeline. The answer comes first (the best match, its main reason and its best time to land), in plain words, with all data labelled demo.",
    "keyCharacteristics": [
      "Full-screen Moon that never moves for chrome",
      "Rail + one solid panel; no glass, no blur",
      "Neutral near-black palette with one logo-orange accent",
      "Teal only for landing windows",
      "Plain wording, demo data labelled",
      "Transform/opacity motion, 200-300 ms, ease-out"
    ],
    "rules": [
      {
        "name": "One accent",
        "body": "Orange marks what is selected or active, nothing else.",
        "section": "colors"
      },
      {
