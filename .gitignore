# Dependencies
node_modules/

# Build output
dist/
# CesiumJS runtime files, copied from node_modules by scripts/copy-cesium-assets.mjs
public/cesium/
dist-ssr/
*.tsbuildinfo

# Test output
coverage/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local environment files and secrets — never commit these
.env
.env.*
!.env.example
*.local
# Vercel CLI link and pulled settings (`vercel link`, `vercel env pull`)
.vercel/
*.pem
*.key

# Raw elevation maps for scripts/data (hundreds of MB): kept on laptops, never committed
*.tif
*.tiff
data-raw/
# The data scripts' own Python environment and caches
scripts/data/.venv/
__pycache__/
# TEST terrain horizons: local only until their source is in docs/DATA_SOURCES.md
# (docs/LANDER_RULES.md, "Terrain horizon"). Remove this line once it is.
src/data/terrainHorizons.ts

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.sw?

# OS
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local (personal) settings
.claude/settings.local.json

# Binaries bundled with installed Claude skills (e.g. impeccable.exe)
.claude/skills/**/*.exe

.vercel
